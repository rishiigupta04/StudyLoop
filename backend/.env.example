# ---- Backend secrets: never prefix with VITE_, never commit the real .env ----
ENV=dev
CORS_ORIGINS=http://localhost:4028,https://studylooop.vercel.app

# Supabase (Settings → API). JWT secret is only needed for legacy HS256 projects;
# projects on asymmetric signing keys are verified via JWKS from SUPABASE_URL.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
REQUIRE_AUTH=true         # false only for an anonymous local demo without Supabase

# Providers
TRANSCRIPT_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b          # answers (Groq no longer serves llama-3.3 on our key)
GROQ_ROUTER_MODEL=openai/gpt-oss-20b    # llm_router tool call
GEMINI_API_KEY=
# hosted speech (roadmap D14): Sarvam Saaras STT + Bulbul TTS; without it STT falls back to Groq Whisper
# (GROQ_API_KEY) and the browser, TTS to the browser voice
SARVAM_API_KEY=
# STT_PROVIDERS=sarvam,groq
# SARVAM_TTS_SPEAKER=shubh
HF_TOKEN=                   # hosted BGE-M3 embeddings (Tier 1a); empty = full-text search only
E5_MODEL_DIR=               # optional CPU fallback embedder (model.onnx + tokenizer.json); needs onnxruntime

# Orchestration
CLASSIFIER=regex            # regex | onnx (Tier 1c model; regex is the rollback)
CONFIDENCE_THRESHOLD=0.85   # regex only: the ONNX model routes on the τ in its bundle's calibration.json
INTENT_MODEL_DIR=           # ONNX bundle dir (ml/install_bundle.py puts one in backend/models/intent, the default)
# HF_WRITE_TOKEN is NOT a backend setting and has no line here on purpose: export it in your shell only for
# `ml/publish_bundle.py --push` (docs/TIER1C_DEPLOY.md). Never put it in this file, backend/.env, Render or Vercel;
# the Docker build downloads the public bundle without any token.
CHECKPOINTER=memory         # memory | postgres (conversation memory across restarts; write-behind, never on the fast path)
